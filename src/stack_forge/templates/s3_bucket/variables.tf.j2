# S3 Bucket Variables
# Generated by Stack Forge

variable "environment" {
  description = "Deployment environment"
  type        = string
}

variable "project" {
  description = "Project name"
  type        = string
}

variable "bucket_name_prefix" {
  description = "Prefix for the S3 bucket name"
  type        = string
  default     = "{{ variables.get('bucket_name_prefix', name) }}"
}

variable "versioning_enabled" {
  description = "Enable versioning for the bucket"
  type        = bool
  default     = {{ variables.get('versioning_enabled', true) | lower }}
}

variable "kms_key_id" {
  description = "KMS key ID for encryption (leave empty for AES256)"
  type        = string
  default     = "{{ variables.get('kms_key_id', '') }}"
}

variable "tags" {
  description = "Additional tags for the bucket"
  type        = map(string)
  default     = {{ tags | terraform_map }}
}
