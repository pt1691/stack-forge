# Secrets Manager Module
# Generated by Stack Forge

locals {
  name = "{{ name }}-${var.environment}"
}

# KMS Key for Secrets Encryption
resource "aws_kms_key" "secrets" {
  count = var.kms_key_id == "" ? 1 : 0

  description             = "KMS key for Secrets Manager secret ${local.name}"
  deletion_window_in_days = 7
  enable_key_rotation     = true

  tags = var.tags
}

resource "aws_kms_alias" "secrets" {
  count = var.kms_key_id == "" ? 1 : 0

  name          = "alias/${local.name}-secrets"
  target_key_id = aws_kms_key.secrets[0].key_id
}

# Secrets Manager Secret
resource "aws_secretsmanager_secret" "this" {
  name        = "${local.name}/${var.secret_path}"
  description = var.description
  kms_key_id  = var.kms_key_id != "" ? var.kms_key_id : aws_kms_key.secrets[0].arn

  recovery_window_in_days = var.recovery_window_in_days

  # Replica regions
  dynamic "replica" {
    for_each = var.replica_regions
    content {
      region     = replica.value.region
      kms_key_id = lookup(replica.value, "kms_key_id", null)
    }
  }

  tags = merge(var.tags, {
    Name = local.name
  })
}

# Secret Value (initial)
resource "aws_secretsmanager_secret_version" "this" {
  count = var.secret_string != "" ? 1 : 0

  secret_id     = aws_secretsmanager_secret.this.id
  secret_string = var.secret_string

  lifecycle {
    ignore_changes = [secret_string]
  }
}

# Secret Rotation
resource "aws_secretsmanager_secret_rotation" "this" {
  count = var.enable_rotation ? 1 : 0

  secret_id           = aws_secretsmanager_secret.this.id
  rotation_lambda_arn = var.rotation_lambda_arn

  rotation_rules {
    automatically_after_days = var.rotation_schedule_expression == "" ? var.rotation_days : null
    schedule_expression      = var.rotation_schedule_expression != "" ? var.rotation_schedule_expression : null
  }
}

# Resource Policy (optional)
resource "aws_secretsmanager_secret_policy" "this" {
  count = var.policy != "" ? 1 : 0

  secret_arn = aws_secretsmanager_secret.this.arn
  policy     = var.policy
}
