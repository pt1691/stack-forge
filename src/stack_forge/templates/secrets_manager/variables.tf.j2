# Secrets Manager Variables
# Generated by Stack Forge

variable "environment" {
  description = "Deployment environment"
  type        = string
}

variable "project" {
  description = "Project name"
  type        = string
}

variable "secret_path" {
  description = "Secret path suffix (appended to name)"
  type        = string
  default     = "{{ variables.get('secret_path', 'default') }}"
}

variable "description" {
  description = "Description of the secret"
  type        = string
  default     = "{{ variables.get('description', 'Managed by Stack Forge') }}"
}

variable "secret_string" {
  description = "Initial secret value (leave empty to set manually)"
  type        = string
  default     = ""
  sensitive   = true
}

variable "kms_key_id" {
  description = "KMS key ID for encryption (leave empty to create new)"
  type        = string
  default     = ""
}

variable "recovery_window_in_days" {
  description = "Number of days before a secret is fully deleted (0 for immediate)"
  type        = number
  default     = {{ variables.get('recovery_window_in_days', 30) }}
}

variable "enable_rotation" {
  description = "Enable automatic secret rotation"
  type        = bool
  default     = {{ variables.get('enable_rotation', false) | lower }}
}

variable "rotation_lambda_arn" {
  description = "ARN of the Lambda function for secret rotation"
  type        = string
  default     = ""
}

variable "rotation_days" {
  description = "Number of days between automatic rotation"
  type        = number
  default     = {{ variables.get('rotation_days', 30) }}
}

variable "rotation_schedule_expression" {
  description = "Cron or rate expression for rotation schedule (overrides rotation_days)"
  type        = string
  default     = ""
}

variable "replica_regions" {
  description = "List of regions to replicate the secret to"
  type = list(object({
    region     = string
    kms_key_id = optional(string)
  }))
  default = []
}

variable "policy" {
  description = "JSON resource policy for the secret (leave empty for no policy)"
  type        = string
  default     = ""
}

variable "tags" {
  description = "Additional tags for Secrets Manager resources"
  type        = map(string)
  default     = {}
}
