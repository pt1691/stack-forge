# VPC Variables
# Generated by Stack Forge

variable "environment" {
  description = "Deployment environment"
  type        = string
}

variable "project" {
  description = "Project name"
  type        = string
}

variable "vpc_cidr" {
  description = "CIDR block for the VPC"
  type        = string
  default     = "{{ variables.get('vpc_cidr', '10.0.0.0/16') }}"
}

variable "az_count" {
  description = "Number of availability zones to use"
  type        = number
  default     = {{ variables.get('az_count', 3) }}
}

variable "enable_nat_gateway" {
  description = "Enable NAT Gateway for private subnets"
  type        = bool
  default     = {{ variables.get('enable_nat_gateway', true) | lower }}
}

variable "single_nat_gateway" {
  description = "Use a single NAT Gateway for all private subnets (cost savings)"
  type        = bool
  default     = {{ variables.get('single_nat_gateway', false) | lower }}
}

variable "enable_flow_logs" {
  description = "Enable VPC Flow Logs"
  type        = bool
  default     = {{ variables.get('enable_flow_logs', true) | lower }}
}

variable "flow_logs_retention_days" {
  description = "Retention period for flow logs in days"
  type        = number
  default     = {{ variables.get('flow_logs_retention_days', 30) }}
}

variable "tags" {
  description = "Additional tags for the VPC resources"
  type        = map(string)
  default     = {}
}
