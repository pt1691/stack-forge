# IAM Role Module
# Generated by Stack Forge

locals {
  name = "{{ name }}-${var.environment}"
}

# IAM Role
resource "aws_iam_role" "this" {
  name        = local.name
  description = var.description
  path        = var.path

  max_session_duration = var.max_session_duration

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = length(var.trusted_role_arns) > 0 ? {
          AWS = var.trusted_role_arns
        } : {
          Service = var.trusted_services
        }
        Action = "sts:AssumeRole"

        Condition = var.assume_role_condition_operator != "" ? {
          "${var.assume_role_condition_operator}" = {
            "${var.assume_role_condition_key}" = var.assume_role_condition_values
          }
        } : null
      }
    ]
  })

  # Permissions boundary
  permissions_boundary = var.permissions_boundary_arn != "" ? var.permissions_boundary_arn : null

  tags = merge(var.tags, {
    Name = local.name
  })
}

# Attach AWS managed policies
resource "aws_iam_role_policy_attachment" "managed" {
  for_each = toset(var.managed_policy_arns)

  role       = aws_iam_role.this.name
  policy_arn = each.value
}

# Inline policy
resource "aws_iam_role_policy" "inline" {
  count = length(var.inline_policy_statements) > 0 ? 1 : 0

  name = "${local.name}-inline-policy"
  role = aws_iam_role.this.id

  policy = jsonencode({
    Version   = "2012-10-17"
    Statement = var.inline_policy_statements
  })
}

# Instance Profile (optional, for EC2 use cases)
resource "aws_iam_instance_profile" "this" {
  count = var.create_instance_profile ? 1 : 0

  name = "${local.name}-instance-profile"
  role = aws_iam_role.this.name

  tags = var.tags
}
