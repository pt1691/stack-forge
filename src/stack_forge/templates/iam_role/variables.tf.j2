# IAM Role Variables
# Generated by Stack Forge

variable "environment" {
  description = "Deployment environment"
  type        = string
}

variable "project" {
  description = "Project name"
  type        = string
}

variable "description" {
  description = "Description of the IAM role"
  type        = string
  default     = "{{ variables.get('description', 'Managed by Stack Forge') }}"
}

variable "path" {
  description = "IAM role path"
  type        = string
  default     = "{{ variables.get('path', '/') }}"
}

variable "max_session_duration" {
  description = "Maximum session duration in seconds"
  type        = number
  default     = {{ variables.get('max_session_duration', 3600) }}
}

variable "trusted_services" {
  description = "AWS services that can assume this role"
  type        = list(string)
  default     = {{ variables.get('trusted_services', ['ec2.amazonaws.com']) | terraform_list }}
}

variable "trusted_role_arns" {
  description = "ARNs of IAM entities that can assume this role"
  type        = list(string)
  default     = []
}

variable "assume_role_condition_operator" {
  description = "Condition operator for assume role policy (e.g., StringEquals)"
  type        = string
  default     = ""
}

variable "assume_role_condition_key" {
  description = "Condition key for assume role policy"
  type        = string
  default     = ""
}

variable "assume_role_condition_values" {
  description = "Condition values for assume role policy"
  type        = list(string)
  default     = []
}

variable "managed_policy_arns" {
  description = "List of AWS managed policy ARNs to attach"
  type        = list(string)
  default     = []
}

variable "inline_policy_statements" {
  description = "Inline IAM policy statements"
  type = list(object({
    Effect   = string
    Action   = list(string)
    Resource = list(string)
  }))
  default = []
}

variable "permissions_boundary_arn" {
  description = "ARN of the permissions boundary policy"
  type        = string
  default     = ""
}

variable "create_instance_profile" {
  description = "Create an IAM instance profile for the role"
  type        = bool
  default     = {{ variables.get('create_instance_profile', false) | lower }}
}

variable "tags" {
  description = "Additional tags for IAM resources"
  type        = map(string)
  default     = {}
}
