# ECR Variables
# Generated by Stack Forge

variable "environment" {
  description = "Deployment environment"
  type        = string
}

variable "project" {
  description = "Project name"
  type        = string
}

variable "image_tag_mutability" {
  description = "Tag mutability setting (MUTABLE or IMMUTABLE)"
  type        = string
  default     = "{{ variables.get('image_tag_mutability', 'IMMUTABLE') }}"
}

variable "scan_on_push" {
  description = "Enable image scanning on push"
  type        = bool
  default     = {{ variables.get('scan_on_push', true) | lower }}
}

variable "force_delete" {
  description = "Force delete repository even if it contains images"
  type        = bool
  default     = {{ variables.get('force_delete', false) | lower }}
}

variable "kms_key_id" {
  description = "KMS key ID for encryption (leave empty for AES256)"
  type        = string
  default     = ""
}

variable "enable_lifecycle_policy" {
  description = "Enable lifecycle policy for image cleanup"
  type        = bool
  default     = {{ variables.get('enable_lifecycle_policy', true) | lower }}
}

variable "untagged_image_expiry_days" {
  description = "Number of days to keep untagged images"
  type        = number
  default     = {{ variables.get('untagged_image_expiry_days', 14) }}
}

variable "max_tagged_image_count" {
  description = "Maximum number of tagged images to retain (0 to disable)"
  type        = number
  default     = {{ variables.get('max_tagged_image_count', 50) }}
}

variable "lifecycle_tag_prefixes" {
  description = "Tag prefixes for lifecycle policy"
  type        = list(string)
  default     = ["v", "release", "build"]
}

variable "repository_policy" {
  description = "JSON repository policy (leave empty for no policy)"
  type        = string
  default     = ""
}

variable "upstream_registry_url" {
  description = "Upstream registry URL for pull-through cache (leave empty to disable)"
  type        = string
  default     = ""
}

variable "pull_through_cache_prefix" {
  description = "ECR repository prefix for pull-through cache"
  type        = string
  default     = "{{ variables.get('pull_through_cache_prefix', 'upstream') }}"
}

variable "tags" {
  description = "Additional tags for ECR resources"
  type        = map(string)
  default     = {}
}
